{
  "domain": "welock",
  "name": "WeLock Smart Lock BLE",
  "bluetooth": [
    {
      "local_name": "WeLock*",
      "connectable": true
    }
  ],
  "codeowners": ["@Ebenhoeh80"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/Ebenhoeh80/welock-bluetooth",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/Ebenhoeh80/welock-bluetooth/issues",
  "loggers": ["custom_components.welock"],
  "requirements": ["aiohttp>=3.9.0", "bleak-retry-connector>=3.1.0"],
  "version": "2.1.2"
}
